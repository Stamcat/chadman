{
  "name": "@stamcat/chadman",
  "version": "0.0.1-alpha.2",
  "type": "module",
  "description": "A lightweight, atomic-design component library built on Base UI and Sass.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stamcat/chadman.git"
  },
  "homepage": "https://github.com/Stamcat/chadman#readme",
  "bugs": {
    "url": "https://github.com/Stamcat/chadman/issues"
  },
  "types": "index.d.ts",
  "main": "index.js",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && tsc -p ./tsconfig-build.json && vite build && tsx ./buildPackage.ts",
    "lint": "oxlint",
    "prepublishOnly": "node ./scripts/prepublishCheck.js",
    "preview": "vite preview",
    "release": "commit-and-tag-version",
    "release:alpha": "npm run release -- --prerelease alpha",
    "release:beta": "npm run release -- --prerelease beta",
    "release:major": "npm run release -- release-as major",
    "release:minor": "npm run release -- release-as minor",
    "release:patch": "npm run release -- release-as patch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run type-check:storybook && storybook build",
    "type-check": "tsc --noEmit",
    "type-check:storybook": "tsc -p ./tsconfig-storybook.json --noEmit",
    "parity:shadcn": "tsx ./scripts/shadcnParity.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-mcp": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "commit-and-tag-version": "13.3.0",
    "fs-extra": "^11.3.0",
    "oxlint": "^1.88.0",
    "playwright": "latest",
    "sass": "^1.106.1",
    "storybook": "^10.6.3",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-lib-inject-css": "^2.2.1",
    "vitest": "latest"
  }
}
